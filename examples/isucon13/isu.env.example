# ISUCON13の練習環境(競技用3台+ベンチ専用1台)での設定例。値は環境に合わせて書き換える
ISU_REPO="$HOME/work/isucon13-app"          # webapp/のgoとsqlを取り込んだgitリポジトリ
ISU_SSH_CONFIG="$HOME/work/isucon13/ssh_config"
ISU_HOSTS="isu13-isu1 isu13-isu2 isu13-isu3"
ISU_BENCH_HOST="isu13-bench"
ISU_REMOTE_DIR="/home/isucon/webapp"
ISU_SYNC_DIRS="go sql"
ISU_REMOTE_OWNER="isucon"
ISU_BUILD_ARTIFACT="isupipe"
ISU_BUILD_CMD="cd go && make build"
ISU_POST_BUILD_CMD="bash sql/apply_indexes.sh"
ISU_APP_UNITS="isupipe-go"
# --nameserverには、DNSのゾーンが返すIP(isu1のプライベートIP)を指定する
ISU_BENCH_CMD="cd /home/isucon && sudo -u isucon ./bench_linux_amd64 run --target https://pipe.u.isucon.dev --nameserver <isu1のプライベートIP> --enable-ssl"
ISU_WHO="${ISU_WHO:-$USER}"
ISU_LEASE_TTL=900
ISU_REQUIRE_PUSHED=0
ISU_NGINX_LOG="/var/log/nginx/access.log"
ISU_SLOW_LOG="/var/log/mysql/mysql-slow.log"
ISU_DB_HOST="isu13-isu1"
