# cp isu.env.example isu.env して編集する(isu.envはgit管理しない)

# 競技アプリのgitリポジトリ(ローカルのclone)
ISU_REPO="$HOME/work/isucon-app"

# sshのHost名(~/.ssh/configに定義)。デプロイ対象を空白区切りで列挙
ISU_HOSTS="isu1 isu2 isu3"

# ベンチマークを実行するホスト(リース用ロックもここに置く)
ISU_BENCH_HOST="isu1"

# サーバー上のアプリの置き場所と、同期するディレクトリ(ISU_REPO直下の名前)。
# サーバー側にgitは不要。git archiveで取り出したファイルをrsyncで配る
ISU_REMOTE_DIR="/home/isucon/webapp"
ISU_SYNC_DIRS="go sql"
ISU_REMOTE_OWNER="isucon"
# ビルド成果物は同期で消さない(--delete対策)
ISU_BUILD_ARTIFACT="isupipe"

# ssh設定ファイルを使う場合に指定
# ISU_SSH_CONFIG="$HOME/work/ssh_config"

# originへのpush済みを要求するか(1で要求、0で不要)
ISU_REQUIRE_PUSHED=1

# ビルドコマンド(ISU_REMOTE_DIR内で実行)
ISU_BUILD_CMD="cd go && make build"

# 常に再起動するユニット。アプリ側のみ。nginxは設定差分があるときだけ再読込
ISU_APP_UNITS="isu-go"

# ベンチマーク実行コマンド(ISU_BENCH_HOST上で実行)
ISU_BENCH_CMD="/home/isucon/bench/bin/benchmarker -u /home/isucon/bench/userdata -t http://localhost"

# ベンチ結果JSONから得点を取り出すjqフィルタ
ISU_SCORE_JQ=".score"
# ベンチがJSONを出さない場合のログ行からの取得(既定値を以下に示す)
# ISU_SCORE_REGEX="スコア: [0-9]+"
# ISU_PASS_GREP="最終チェックが成功しました"

# 作業者の識別名。複数エージェントを同一端末で動かす場合は必ず別名にする
ISU_WHO="${ISU_WHO:-$USER}"

# リースの有効時間(秒)。これを超えて保持された場合は奪取できる
ISU_LEASE_TTL=900

# nginxアクセスログ、スロークエリログの場所
ISU_NGINX_LOG="/var/log/nginx/access.log"
ISU_SLOW_LOG="/var/log/mysql/mysql-slow.log"
ISU_DB_HOST="isu1"

# alpでURIをまとめる正規表現(カンマ区切り)。題材に合わせて書く
# 例(ISUCON13): ISU_ALP_GROUPS='/api/user/[^/]+/icon,/api/user/[^/]+/theme,/api/user/[^/]+/statistics,/api/user/[^/]+,/api/livestream/[0-9]+/livecomment/[0-9]+/report,/api/livestream/[0-9]+/[a-z_]+/[0-9]+,/api/livestream/[0-9]+/[a-z_-]+,/api/livestream/[0-9]+'
ISU_ALP_GROUPS=""
