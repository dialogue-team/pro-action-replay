# cp isu.env.example isu.env して編集する(isu.envはgit管理しない)

# 競技アプリのgitリポジトリ(ローカルのclone)
ISU_REPO="$HOME/work/isucon-app"

# sshのHost名(~/.ssh/configに定義)。デプロイ対象を空白区切りで列挙
ISU_HOSTS="isu1 isu2 isu3"

# ベンチマークを実行するホスト(リース用ロックもここに置く)
ISU_BENCH_HOST="isu1"

# サーバー上のアプリリポジトリの場所(各ホストにcloneしておく)
ISU_REMOTE_DIR="/home/isucon/app"

# ビルドコマンド(ISU_REMOTE_DIR内で実行)
ISU_BUILD_CMD="make -C webapp/golang"

# 常に再起動するユニット。アプリ側のみ。nginxは設定差分があるときだけ再読込
ISU_APP_UNITS="isu-go"

# ベンチマーク実行コマンド(ISU_BENCH_HOST上で実行)
ISU_BENCH_CMD="/home/isucon/bench/bin/benchmarker -u /home/isucon/bench/userdata -t http://localhost"

# ベンチ結果JSONから得点を取り出すjqフィルタ
ISU_SCORE_JQ=".score"

# 作業者の識別名。複数エージェントを同一端末で動かす場合は必ず別名にする
ISU_WHO="${ISU_WHO:-$USER}"

# リースの有効時間(秒)。これを超えて保持された場合は奪取できる
ISU_LEASE_TTL=900

# nginxアクセスログ、スロークエリログの場所
ISU_NGINX_LOG="/var/log/nginx/access.log"
ISU_SLOW_LOG="/var/log/mysql/mysql-slow.log"
ISU_DB_HOST="isu1"
